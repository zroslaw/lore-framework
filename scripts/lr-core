#!/usr/bin/env python3
"""Stable CLI and import-compatible entry point for lr_core.

Implementation lives by responsibility under scripts/lr_core/. Keep this path
stable because framework procedures and external callers invoke it directly.

discover, preflight, and scan emit one JSON object. Exit 0 means the command
completed, including a determinate ``ok: false``; exit 2 means it could not
complete and the caller uses the Script Fallback Contract. Their hand-readable
procedures live in preflight.py and scan.py.

lore-map and lore-workset emit deterministic YAML. They are implementations,
not accelerators: exit 2 stops map enrichment or grooming rather than asking an
agent to reproduce their logic manually.
"""

import os
import sys

_SCRIPTS_DIR = os.path.dirname(os.path.realpath(__file__))
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)

from lr_core import *  # noqa: E402,F401,F403


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
