#!/usr/bin/env python3
"""session-takeover — list engine sessions and convert one into a takeover digest.

Supports taking over a session recorded by one coding engine in another engine:
the session log is parsed into a unified message list, then rendered as a
markdown digest that any agent on any engine (Claude Code, Codex, Cursor) can
load into context to continue the work.

Pipeline: <engine log> -> [parser] -> message list -> [renderer] -> digest

The unified message list uses the de facto API message shape:
    {"role": "user"|"assistant", "content": str}                     -- a turn
    {"role": "assistant", "tool": name, "args": str, "result": str}  -- a tool call
Adding a new engine only requires a new parse_<engine>() function and a
list_<engine>() discovery function.

Engine support:
    codex   -- list + convert (~/.codex/sessions rollout JSONL)
    claude  -- list + convert (~/.claude/projects session JSONL)
    cursor  -- list + convert (~/.cursor/chats index + agent-transcripts JSONL;
               tool results paired from store.db via batch-window matching)

Usage:
    session-takeover --list [--engine E] [--limit N]
    session-takeover <session-id | log-path> [-o digest.md] [--json out.json]

With no -o, the digest is written to stdout.
"""

import argparse
import binascii
import contextlib
import glob
import gzip
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path

TRUNC_ARGS = 160     # max chars shown for tool-call arguments
TRUNC_RESULT = 120   # max chars shown for tool-call results

ARCHIVE_SCHEMA_VERSION = 1  # bump when the archive line/record shape changes

CODEX_HOME = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
CLAUDE_PROJECTS = Path(
    os.environ.get("CLAUDE_PROJECTS", Path.home() / ".claude" / "projects")
)
_CURSOR_GENERIC_TITLES = frozenset({"New Agent", "New Chat"})

# --- Claude model pricing, USD per million tokens (per-token cost / 1e6) ------
# Source: https://platform.claude.com/docs/en/about-claude/pricing
# Fetched 2026-07-21. Tuple = (input, output, cache_read, cache_write_5m).
# cache_write_5m (1.25x base input) is used because the transcript's
# cache_creation_input_tokens does not distinguish 5-minute from 1-hour writes;
# 5m is the documented default. Cost carrying this table is labelled
# cost_source="computed" precisely to flag it as an estimate, not billed truth.
# Sonnet 5 shows introductory pricing ($2/$10) in effect through 2026-08-31;
# it rises to $3/$15 on 2026-09-01 — refresh this table then.
CLAUDE_PRICING = {
    "claude-fable-5": (10.0, 50.0, 1.0, 12.5),
    "claude-mythos-5": (10.0, 50.0, 1.0, 12.5),
    "claude-opus-4-8": (5.0, 25.0, 0.5, 6.25),
    "claude-opus-4-7": (5.0, 25.0, 0.5, 6.25),
    "claude-opus-4-6": (5.0, 25.0, 0.5, 6.25),
    "claude-opus-4-5": (5.0, 25.0, 0.5, 6.25),
    "claude-opus-4-1": (15.0, 75.0, 1.5, 18.75),
    "claude-opus-4-0": (15.0, 75.0, 1.5, 18.75),
    "claude-sonnet-5": (2.0, 10.0, 0.2, 2.5),
    "claude-sonnet-4-6": (3.0, 15.0, 0.3, 3.75),
    "claude-sonnet-4-5": (3.0, 15.0, 0.3, 3.75),
    "claude-sonnet-4-0": (3.0, 15.0, 0.3, 3.75),
    "claude-haiku-4-5": (1.0, 5.0, 0.1, 1.25),
    "claude-haiku-3-5": (0.8, 4.0, 0.08, 1.0),
}


def _cursor_home():
    return Path(os.environ.get("CURSOR_HOME", str(Path.home() / ".cursor")))


def _cursor_chats():
    return _cursor_home() / "chats"


def _cursor_projects():
    return _cursor_home() / "projects"


def _clip(text, limit):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


# --- usage / model aggregation helpers (Feature B) ---------------------------


def _new_usage():
    return {"input": 0, "output": 0, "cache_read": 0, "cache_creation": 0}


def _add_usage(acc, other):
    """Sum a normalized usage dict into an accumulator in place."""
    for key in ("input", "output", "cache_read", "cache_creation"):
        acc[key] += int(other.get(key) or 0)


def _claude_usage_to_norm(u):
    """Map a Claude message.usage dict to the normalized token shape."""
    return {
        "input": int(u.get("input_tokens") or 0),
        "output": int(u.get("output_tokens") or 0),
        "cache_read": int(u.get("cache_read_input_tokens") or 0),
        "cache_creation": int(u.get("cache_creation_input_tokens") or 0),
    }


def _add_model(models, model):
    """Append a model id to an ordered-unique list, in place."""
    if model and model not in models:
        models.append(model)


def _normalize_model_id(model):
    """Strip a trailing -YYYYMMDD date suffix so dated ids hit the price table."""
    if not model:
        return model
    return re.sub(r"-\d{8}$", "", model)


def _claude_model_cost(model, usage):
    """USD cost for one model's normalized usage, or None if model unpriced."""
    price = CLAUDE_PRICING.get(_normalize_model_id(model))
    if price is None:
        return None
    in_rate, out_rate, cr_rate, cw_rate = price
    return (
        usage["input"] * in_rate
        + usage["output"] * out_rate
        + usage["cache_read"] * cr_rate
        + usage["cache_creation"] * cw_rate
    ) / 1_000_000


def compute_stats(meta, messages=None):
    """Build the Feature-B stats object (models, tokens, cost) from parse meta.

    Cost is only computed for Claude and only when every model used is present
    in CLAUDE_PRICING; any unknown model -> cost_source "unavailable" (never a
    guessed number). Codex/Cursor are always cost "unavailable" in v1.
    """
    engine = meta.get("engine")
    models = list(meta.get("models") or [])
    if not models and meta.get("model"):
        models = [meta["model"]]
    models_source = meta.get("models_source")
    if not models_source:
        models_source = "per-message" if models else "unavailable"

    tokens = meta.get("usage")  # normalized dict or None (unavailable)

    cost_usd, cost_source = None, "unavailable"
    by_model = meta.get("usage_by_model")
    if engine == "claude" and by_model:
        total = 0.0
        priced_all = True
        for model, usage in by_model.items():
            c = _claude_model_cost(model, usage)
            if c is None:
                priced_all = False
                break
            total += c
        if priced_all:
            cost_usd, cost_source = round(total, 4), "computed"

    stats = {
        "engine": engine,
        "models": models,
        "models_source": models_source,
        "tokens": tokens,
        "cost_usd": cost_usd,
        "cost_source": cost_source,
    }
    if messages is not None:
        earliest = next((m["ts"] for m in messages if m.get("ts")), None)
        stats["started"] = meta.get("started") or earliest
    return stats


# ------------------------------------------------------------ codex parsing


def _codex_call_summary(name, raw_args):
    if name == "exec_command":
        try:
            cmd = json.loads(raw_args).get("cmd", raw_args)
        except (json.JSONDecodeError, AttributeError):
            cmd = raw_args
        return _clip(cmd, TRUNC_ARGS)
    if name == "apply_patch":
        ops = re.findall(r"\*\*\* (Add|Update|Delete) File: (.+)", raw_args or "")
        if ops:
            return "; ".join(f"{op.lower()} {path.strip()}" for op, path in ops)
    return _clip(raw_args or "", TRUNC_ARGS)


def _codex_result_summary(output):
    text = str(output or "")
    exit_m = re.search(r"Process exited with code (\d+)", text)
    lines = [
        ln.strip()
        for ln in text.splitlines()
        if ln.strip()
        and not re.match(
            r"(Chunk ID|Wall time|Process exited|Original token count|Output)", ln
        )
    ]
    first = _clip(lines[0], TRUNC_RESULT) if lines else ""
    if exit_m:
        status = "ok" if exit_m.group(1) == "0" else f"exit {exit_m.group(1)}"
        return f"{status}: {first}" if first else status
    return first


def parse_codex(path):
    """Parse a Codex rollout JSONL file -> (meta, messages)."""
    meta = {"engine": "codex", "source": str(path)}
    messages = []
    pending = {}  # call_id -> tool message awaiting its result
    models = []
    token_usage = None  # cumulative; last token_count record wins

    for record in _iter_jsonl(path):
        rtype = record.get("type")
        payload = record.get("payload", {})
        ts = record.get("timestamp")

        if rtype == "session_meta":
            meta.update(
                session_id=payload.get("id"),
                started=payload.get("timestamp"),
                cwd=payload.get("cwd"),
                originator=payload.get("originator"),
                cli_version=payload.get("cli_version"),
            )
        elif rtype == "turn_context":
            meta.setdefault("model", payload.get("model"))
            _add_model(models, payload.get("model"))
            meta["ended"] = ts or meta.get("ended")
        elif rtype == "event_msg" and payload.get("type") == "token_count":
            # Codex reports cumulative token usage; the last record is the total.
            info = payload.get("info") or {}
            total = info.get("total_token_usage") or {}
            if total:
                token_usage = {
                    "input": int(total.get("input_tokens") or 0),
                    "output": int(total.get("output_tokens") or 0)
                    + int(total.get("reasoning_output_tokens") or 0),
                    "cache_read": int(total.get("cached_input_tokens") or 0),
                    "cache_creation": 0,
                }
        elif rtype == "response_item":
            ptype = payload.get("type")
            if ptype == "message":
                role = payload.get("role")
                if role not in ("user", "assistant"):
                    continue  # developer/system plumbing
                text = "\n".join(
                    c.get("text", "")
                    for c in payload.get("content", [])
                    if c.get("type") in ("input_text", "output_text")
                ).strip()
                # engine-injected context arrives tag-wrapped in the user role
                if role == "user" and re.match(r"^<[a-z_]+>", text):
                    continue
                if text:
                    messages.append({"role": role, "content": text, "ts": ts})
            elif ptype in ("function_call", "custom_tool_call"):
                name = payload.get("name", "?")
                raw = payload.get("arguments") or payload.get("input") or ""
                msg = {
                    "role": "assistant",
                    "tool": name,
                    "args": _codex_call_summary(name, raw),
                    "result": "",
                    "raw_args": raw,
                    "raw_result": "",
                    "ts": ts,
                }
                messages.append(msg)
                call_id = payload.get("call_id") or payload.get("id")
                if call_id:
                    pending[call_id] = msg
            elif ptype in ("function_call_output", "custom_tool_call_output"):
                output = payload.get("output")
                if isinstance(output, dict):
                    output = output.get("content") or json.dumps(output)
                msg = pending.pop(payload.get("call_id"), None)
                if msg is not None:
                    msg["result"] = _codex_result_summary(output)
                    msg["raw_result"] = output

    if models:
        meta["models"] = models
        meta["models_source"] = "per-message"
    if token_usage:
        meta["usage"] = token_usage
    return meta, messages


# ----------------------------------------------------------- claude parsing

# Tool-arg fields that best identify a call, tried in order per tool.
_CLAUDE_ARG_KEYS = {
    "Bash": ["command"],
    "Read": ["file_path"],
    "Write": ["file_path"],
    "Edit": ["file_path"],
    "NotebookEdit": ["notebook_path"],
    "Glob": ["pattern"],
    "Grep": ["pattern"],
    "WebFetch": ["url"],
    "WebSearch": ["query"],
    "Agent": ["description"],
    "Skill": ["skill"],
}


def _claude_call_summary(name, args):
    if not isinstance(args, dict):
        return _clip(args or "", TRUNC_ARGS)
    for key in _CLAUDE_ARG_KEYS.get(name, []):
        if args.get(key):
            return _clip(args[key], TRUNC_ARGS)
    return _clip(json.dumps(args, ensure_ascii=False), TRUNC_ARGS)


def _claude_result_join(item):
    """Full, unclipped text of a Claude tool_result content block."""
    content = item.get("content")
    if isinstance(content, list):
        content = " ".join(
            c.get("text", "") for c in content if isinstance(c, dict)
        )
    prefix = "error: " if item.get("is_error") else ""
    return prefix + str(content or "")


def _claude_result_text(item):
    return _clip(_claude_result_join(item), TRUNC_RESULT)


def parse_claude(path):
    """Parse a Claude Code session JSONL file -> (meta, messages).

    Sidechain (subagent/Task) records are parsed and emitted too, each tagged
    ``sidechain: True``; the digest renderer (render_markdown) skips them so
    the takeover digest is byte-identical to before, while the archive and the
    usage totals include them — real tokens were spent on that work.
    """
    meta = {"engine": "claude", "source": str(path)}
    messages = []
    pending = {}  # tool_use_id -> tool message awaiting its result
    models = []
    total_usage = None
    usage_by_model = {}

    for record in _iter_jsonl(path):
        rtype = record.get("type")
        if rtype == "ai-title":
            meta["title"] = record.get("aiTitle") or meta.get("title")
            continue
        if rtype not in ("user", "assistant"):
            continue
        sidechain = bool(record.get("isSidechain"))
        ts = record.get("timestamp")

        # Session-level meta reflects the main thread only, so the digest's
        # Session block stays identical to before (sidechains were skipped then).
        if not sidechain:
            meta.setdefault("session_id", record.get("sessionId"))
            meta.setdefault("cwd", record.get("cwd"))
            meta.setdefault("started", ts)
            meta["ended"] = ts or meta.get("ended")

        message = record.get("message") or {}
        content = message.get("content")

        if rtype == "user":
            if isinstance(content, str):
                # engine-injected wrappers (<command-name>, caveats, reminders)
                if not re.match(r"^\s*<[a-z-]+", content) and content.strip():
                    messages.append({
                        "role": "user", "content": content.strip(),
                        "ts": ts, "sidechain": sidechain,
                    })
                continue
            for item in content or []:
                itype = item.get("type")
                if itype == "text":
                    text = item.get("text", "").strip()
                    if text and not re.match(r"^\s*<[a-z-]+", text):
                        messages.append({
                            "role": "user", "content": text,
                            "ts": ts, "sidechain": sidechain,
                        })
                elif itype == "tool_result":
                    msg = pending.pop(item.get("tool_use_id"), None)
                    if msg is not None:
                        msg["result"] = _claude_result_text(item)
                        msg["raw_result"] = _claude_result_join(item)

        else:  # assistant
            model = message.get("model")
            if model and model != "<synthetic>":
                if not sidechain:
                    meta.setdefault("model", model)
                _add_model(models, model)
            usage = message.get("usage")
            if usage and model and model != "<synthetic>":
                norm = _claude_usage_to_norm(usage)
                if total_usage is None:
                    total_usage = _new_usage()
                _add_usage(total_usage, norm)
                acc = usage_by_model.setdefault(model, _new_usage())
                _add_usage(acc, norm)
            for item in content or []:
                itype = item.get("type")
                if itype == "text":
                    text = item.get("text", "").strip()
                    if text and model != "<synthetic>":
                        messages.append({
                            "role": "assistant", "content": text,
                            "ts": ts, "model": model, "sidechain": sidechain,
                        })
                elif itype == "tool_use":
                    name = item.get("name", "?")
                    msg = {
                        "role": "assistant",
                        "tool": name,
                        "args": _claude_call_summary(name, item.get("input")),
                        "result": "",
                        "raw_args": item.get("input"),
                        "raw_result": "",
                        "ts": ts,
                        "model": model,
                        "sidechain": sidechain,
                    }
                    messages.append(msg)
                    if item.get("id"):
                        pending[item["id"]] = msg

    if models:
        meta["models"] = models
        meta["models_source"] = "per-message"
    if total_usage is not None:
        meta["usage"] = total_usage
        meta["usage_by_model"] = usage_by_model
    return meta, messages


# ----------------------------------------------------------- cursor parsing

_CURSOR_ARG_KEYS = {
    "Shell": ["command"],
    "Read": ["path"],
    "Write": ["path"],
    "StrReplace": ["path"],
    "Delete": ["path"],
    "Glob": ["glob_pattern"],
    "Grep": ["pattern"],
    "WebFetch": ["url"],
    "WebSearch": ["search_term"],
    "Task": ["description"],
    "CallMcpTool": ["toolName"],
    "GenerateImage": ["description"],
}


def _cursor_call_summary(name, args):
    if not isinstance(args, dict):
        return _clip(args or "", TRUNC_ARGS)
    for key in _CURSOR_ARG_KEYS.get(name, []):
        if args.get(key):
            return _clip(args[key], TRUNC_ARGS)
    return _clip(json.dumps(args, ensure_ascii=False), TRUNC_ARGS)


def _cursor_result_summary(result):
    if isinstance(result, dict):
        text = result.get("content") or json.dumps(result, ensure_ascii=False)
    else:
        text = str(result or "")
    if "exit code" in text.lower() or "Exit code:" in text:
        first = text.splitlines()[0] if text.splitlines() else text
        return _clip(first, TRUNC_RESULT)
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    return _clip(lines[0] if lines else text, TRUNC_RESULT)


def _cursor_extract_user_text(raw):
    text = raw.strip()
    if not text:
        return None
    match = re.search(r"<user_query>\s*(.*?)\s*</user_query>", text, re.S)
    if match:
        return match.group(1).strip()
    text = re.sub(r"<timestamp>.*?</timestamp>\s*", "", text, flags=re.S).strip()
    if not text or re.match(r"^\s*<[a-z-]+", text):
        return None
    return text


def _cursor_jsonl_paths_for_uuid(session_uuid):
    return [
        Path(p)
        for p in glob.glob(
            str(
                _cursor_projects()
                / "*"
                / "agent-transcripts"
                / session_uuid
                / f"{session_uuid}.jsonl"
            )
        )
    ]


def _cursor_unique_path(hits, label, session_uuid, *, strict=False):
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        if strict:
            sys.exit(
                f"error: multiple {label} for Cursor chat {session_uuid}:\n  "
                + "\n  ".join(str(h) for h in hits)
            )
        return None
    return None


def cursor_jsonl_for_uuid(session_uuid, *, strict=False):
    return _cursor_unique_path(
        _cursor_jsonl_paths_for_uuid(session_uuid),
        "agent-transcript paths",
        session_uuid,
        strict=strict,
    )


def cursor_store_db_for_uuid(session_uuid, *, strict=False):
    hits = [
        Path(p)
        for p in glob.glob(str(_cursor_chats() / "*" / session_uuid / "store.db"))
    ]
    return _cursor_unique_path(
        hits, "store.db paths", session_uuid, strict=strict
    )


def cursor_chat_meta_for_uuid(session_uuid):
    hits = glob.glob(str(_cursor_chats() / "*" / session_uuid / "meta.json"))
    if len(hits) != 1:
        return {}
    try:
        return json.loads(Path(hits[0]).read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def cursor_store_meta(store_db):
    if store_db is None or not store_db.is_file():
        return {}
    try:
        with contextlib.closing(sqlite3.connect(store_db)) as conn:
            row = conn.execute("SELECT value FROM meta WHERE key=0").fetchone()
        if not row:
            return {}
        raw = row[0]
        if isinstance(raw, str) and re.fullmatch(r"[0-9a-fA-F]+", raw):
            raw = binascii.unhexlify(raw)
        elif isinstance(raw, bytes):
            try:
                raw = binascii.unhexlify(raw)
            except binascii.Error:
                pass
        if isinstance(raw, (bytes, bytearray)):
            raw = raw.decode("utf-8", errors="replace")
        return json.loads(raw)
    except (json.JSONDecodeError, OSError, sqlite3.Error, binascii.Error):
        return {}


def cursor_first_user_query(jsonl_path):
    for record in _iter_jsonl(jsonl_path):
        if record.get("role") != "user":
            continue
        for item in (record.get("message") or {}).get("content") or []:
            if item.get("type") != "text":
                continue
            text = _cursor_extract_user_text(item.get("text", ""))
            if text:
                return _clip(text, 60)
    return None


def cursor_session_status(jsonl_path):
    ended = False
    for record in _iter_jsonl(jsonl_path):
        if record.get("type") == "turn_ended":
            ended = True
    return "completed" if ended else "in-progress"


def _cursor_load_tool_results(store_db):
    results = []
    if store_db is None or not store_db.is_file():
        return results
    with contextlib.closing(sqlite3.connect(store_db)) as conn:
        rows = list(
            conn.execute("SELECT rowid, id, data FROM blobs ORDER BY rowid")
        )
    for _rowid, _blob_id, data in rows:
        if not data or data[:1] != b"{":
            continue
        try:
            record = json.loads(data)
        except json.JSONDecodeError:
            continue
        if record.get("role") != "tool":
            continue
        for item in record.get("content") or []:
            if item.get("type") != "tool-result":
                continue
            results.append(
                {
                    "name": item.get("toolName", "?"),
                    "result": _cursor_result_summary(item.get("result")),
                    "raw_result": item.get("result"),
                }
            )
    return results


def _cursor_batch_has_duplicate_names(tool_uses):
    names = [tool.get("name", "?") for tool in tool_uses]
    return len(names) != len(set(names))


def _cursor_pair_tool_batch(tool_uses, results, result_index):
    """Pair one assistant JSONL batch of tool_use items with store.db results.

    Cursor may complete parallel tool calls in a different order than JSONL
    lists them. Pair within a fixed-size window (the next len(batch) results in
    sqlite rowid order) by tool name, in JSONL invocation order.
    """
    window_end = result_index + len(tool_uses)
    window = results[result_index:window_end]
    used = set()
    paired = []
    for tool in tool_uses:
        name = tool.get("name", "?")
        match = None
        for idx, item in enumerate(window):
            if idx in used:
                continue
            if item["name"] == name:
                match = item
                used.add(idx)
                break
        if match:
            paired.append((match["result"], match.get("raw_result")))
        else:
            paired.append(("", None))
    return paired, window_end


def _cursor_resolved_title(store_info, jsonl_path):
    title = store_info.get("name")
    if title in _CURSOR_GENERIC_TITLES:
        title = None
    return title or cursor_first_user_query(jsonl_path) or "(untitled)"


def parse_cursor(path):
    """Parse a Cursor agent-transcript JSONL + store.db tool results."""
    jsonl_path = Path(path)
    session_id = jsonl_path.stem
    store_db = cursor_store_db_for_uuid(session_id, strict=True)
    chat_meta = cursor_chat_meta_for_uuid(session_id)
    store_info = cursor_store_meta(store_db)

    meta = {
        "engine": "cursor",
        "source": str(jsonl_path),
        "session_id": session_id,
        "cwd": chat_meta.get("cwd"),
        "status": cursor_session_status(jsonl_path),
    }
    meta["title"] = _cursor_resolved_title(store_info, jsonl_path)
    if store_info.get("lastUsedModel"):
        meta["model"] = store_info["lastUsedModel"]
        meta["models"] = [store_info["lastUsedModel"]]
        meta["models_source"] = "session-level-last-used"
    if chat_meta.get("createdAtMs"):
        meta["started"] = _fmt_ts(chat_meta["createdAtMs"] / 1000)
    if chat_meta.get("updatedAtMs"):
        meta["ended"] = _fmt_ts(chat_meta["updatedAtMs"] / 1000)

    tool_results = _cursor_load_tool_results(store_db)
    result_index = 0
    messages = []
    paired_tools = 0
    duplicate_name_batches = False

    for record in _iter_jsonl(jsonl_path):
        if record.get("type") == "turn_ended":
            continue
        role = record.get("role")
        if role == "user":
            for item in (record.get("message") or {}).get("content") or []:
                if item.get("type") != "text":
                    continue
                text = _cursor_extract_user_text(item.get("text", ""))
                if text:
                    messages.append({"role": "user", "content": text})
        elif role == "assistant":
            content = (record.get("message") or {}).get("content") or []
            text_parts = []
            tool_uses = []
            for item in content:
                if item.get("type") == "text":
                    text = (item.get("text") or "").strip()
                    if text and text != "[REDACTED]":
                        text_parts.append(text)
                elif item.get("type") == "tool_use":
                    tool_uses.append(item)
            if text_parts:
                messages.append(
                    {"role": "assistant", "content": "\n\n".join(text_parts)}
                )
            if tool_uses:
                if _cursor_batch_has_duplicate_names(tool_uses):
                    duplicate_name_batches = True
                paired_results, result_index = _cursor_pair_tool_batch(
                    tool_uses, tool_results, result_index
                )
                for tool, (result, raw_result) in zip(tool_uses, paired_results):
                    if result:
                        paired_tools += 1
                    messages.append(
                        {
                            "role": "assistant",
                            "tool": tool.get("name", "?"),
                            "args": _cursor_call_summary(
                                tool.get("name"), tool.get("input")
                            ),
                            "result": result,
                            "raw_args": tool.get("input"),
                            "raw_result": raw_result,
                        }
                    )

    meta["tool_results_paired"] = paired_tools
    meta["tool_calls_total"] = sum(
        1 for msg in messages if "tool" in msg
    )
    if len(tool_results) != meta["tool_calls_total"]:
        meta["pairing_uncertain"] = True
    if duplicate_name_batches:
        meta["pairing_uncertain"] = True
    return meta, messages


# ------------------------------------------------------------------ shared


def _iter_jsonl(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


PARSERS = {"codex": parse_codex, "claude": parse_claude, "cursor": parse_cursor}


def detect_engine(path):
    """Sniff the log format from the first few records."""
    path = Path(path)
    if path.suffix == ".jsonl" and "agent-transcripts" in str(path):
        return "cursor"
    for record in _iter_jsonl(path):
        if record.get("type") == "session_meta":
            return "codex"
        if "sessionId" in record:
            return "claude"
        if record.get("role") in ("user", "assistant") and "message" in record:
            return "cursor"
    return None


# --------------------------------------------------------------- discovery


def _fmt_ts(epoch):
    """Format a Unix epoch timestamp for display in the local timezone."""
    if not epoch:
        return "?"
    return datetime.fromtimestamp(epoch).strftime("%Y-%m-%d %H:%M")


def _is_temp_cwd(cwd):
    """Sessions run in temp dirs are almost always automated test fixtures."""
    return bool(cwd) and cwd.startswith(("/tmp/", "/private/var/folders/",
                                         "/var/folders/", "/private/tmp/"))


def list_codex(limit, include_all=False):
    """Non-archived Codex sessions, newest first, named ones from the index."""
    names = {}
    index = CODEX_HOME / "session_index.jsonl"
    if index.is_file():
        for record in _iter_jsonl(index):
            names[record.get("id")] = record.get("thread_name")

    sessions = []
    for path in glob.glob(str(CODEX_HOME / "sessions" / "**" / "rollout-*.jsonl"),
                          recursive=True):
        m = re.search(r"rollout-.*?-([0-9a-f-]{36})\.jsonl$", path)
        sid = m.group(1) if m else None
        title = names.get(sid)
        if not title:
            continue  # unnamed rollouts are automated sub-runs; skip in listing
        sessions.append(
            {
                "engine": "codex",
                "id": sid,
                "title": title,
                "updated": os.path.getmtime(path),
                "path": path,
            }
        )
    sessions.sort(key=lambda s: s["updated"], reverse=True)
    return sessions[:limit]


def list_claude(limit, include_all=False):
    """Claude Code sessions across all project dirs, newest first."""
    sessions = []
    for path in glob.glob(str(CLAUDE_PROJECTS / "*" / "*.jsonl")):
        sessions.append((os.path.getmtime(path), path))
    sessions.sort(reverse=True)

    out = []
    for mtime, path in sessions[: limit * 4]:  # over-scan; some have no dialog
        title, first_prompt, cwd, has_dialog = None, None, None, False
        for i, record in enumerate(_iter_jsonl(path)):
            if record.get("type") == "ai-title":
                title = record.get("aiTitle")
                break  # canonical title found; stop scanning
            if record.get("type") == "user" and not record.get("isSidechain"):
                cwd = cwd or record.get("cwd")
                content = (record.get("message") or {}).get("content")
                if isinstance(content, str) and not content.startswith("<"):
                    has_dialog = True
                    first_prompt = first_prompt or _clip(content, 60)
            if i > 300:  # title lines live near the top; don't scan huge logs
                break
        if not (has_dialog or title):
            continue
        if _is_temp_cwd(cwd) and not include_all:
            continue
        title = title or first_prompt
        out.append(
            {
                "engine": "claude",
                "id": Path(path).stem,
                "title": title or "(untitled)",
                "cwd": cwd,
                "updated": mtime,
                "path": path,
            }
        )
        if len(out) >= limit:
            break
    return out


def list_cursor(limit, include_all=False):
    """Cursor chats from meta.json; paths point at agent-transcript JSONL."""
    sessions = []
    for meta_path in glob.glob(str(_cursor_chats() / "*" / "*" / "meta.json")):
        try:
            info = json.loads(Path(meta_path).read_text())
        except (json.JSONDecodeError, OSError):
            continue
        if not info.get("hasConversation"):
            continue
        if _is_temp_cwd(info.get("cwd")) and not include_all:
            continue
        session_id = Path(meta_path).parent.name
        jsonl_path = cursor_jsonl_for_uuid(session_id)
        store_db = Path(meta_path).parent / "store.db"
        store_info = cursor_store_meta(store_db)
        if jsonl_path:
            title = _cursor_resolved_title(store_info, jsonl_path)
        else:
            name = store_info.get("name")
            title = name if name not in _CURSOR_GENERIC_TITLES else "(untitled)"
        status = cursor_session_status(jsonl_path) if jsonl_path else "no-transcript"
        updated = info.get("updatedAtMs") or info.get("createdAtMs") or 0
        sessions.append(
            {
                "engine": "cursor",
                "id": session_id,
                "title": title,
                "cwd": info.get("cwd"),
                "updated": updated / 1000,
                "path": str(jsonl_path or store_db),
                "model": store_info.get("lastUsedModel"),
                "status": status,
                "is_subagent": bool(info.get("isSubagent")),
            }
        )
    sessions.sort(key=lambda s: s["updated"], reverse=True)
    return sessions[:limit]


LISTERS = {"codex": list_codex, "claude": list_claude, "cursor": list_cursor}


def resolve_session(token):
    """Turn a session id (or id prefix) into a log path."""
    candidates = glob.glob(
        str(CODEX_HOME / "sessions" / "**" / f"rollout-*{token}*.jsonl"),
        recursive=True,
    ) + glob.glob(str(CLAUDE_PROJECTS / "*" / f"{token}*.jsonl"))
    cursor_candidates = []
    for hit in glob.glob(
        str(_cursor_projects() / "*" / "agent-transcripts" / f"*{token}*" / f"*{token}*.jsonl")
    ):
        path = Path(hit)
        if path.parent.name == path.stem:
            cursor_candidates.append(str(path))
    candidates.extend(cursor_candidates)
    if len(candidates) == 1:
        return Path(candidates[0])
    if len(candidates) > 1:
        sys.exit(
            f"error: session id '{token}' is ambiguous:\n  "
            + "\n  ".join(candidates)
        )
    return None


# --------------------------------------------------------------- rendering


def render_markdown(meta, messages):
    out = ["# Session takeover digest", ""]
    out.append(
        "> This is a digest of a session recorded on another engine. "
        "You are taking that session over: treat the conversation below as "
        "your own prior context and continue from where it stopped. "
        "Tool calls are collapsed to one-line summaries; files the session "
        "created or modified are still on disk."
    )
    out += ["", "## Session", ""]
    for key in (
        "engine",
        "title",
        "model",
        "status",
        "originator",
        "cli_version",
        "session_id",
        "started",
        "ended",
        "cwd",
        "source",
        "tool_results_paired",
        "tool_calls_total",
        "pairing_uncertain",
    ):
        if meta.get(key) is not None and meta.get(key) != "":
            out.append(f"- {key}: `{meta[key]}`")
    out += ["", "## Transcript"]

    current = None  # role of the heading we're currently under
    for msg in messages:
        if msg.get("sidechain"):
            continue  # subagent turns are archived, not shown in the digest
        if "tool" in msg:
            if current != "assistant":
                out += ["", "## Assistant", ""]
                current = "assistant"
            result = f" -> {msg['result']}" if msg["result"] else ""
            out.append(f"- `[{msg['tool']}]` {msg['args']}{result}")
            continue
        heading = "## User" if msg["role"] == "user" else "## Assistant"
        out += ["", heading, "", msg["content"]]
        current = msg["role"]

    out += [
        "",
        "---",
        "**The recorded session ends here.** If the last assistant turn was "
        "mid-task, that work is unfinished — verify current on-disk state "
        "before continuing, then pick up where it stopped.",
        "",
    ]
    if meta.get("engine") == "cursor":
        note = (
            "> **Cursor transcript note.** Cursor stores some assistant turns "
            "as `[REDACTED]` at rest; those lines are omitted from this digest."
        )
        paired = meta.get("tool_results_paired")
        total = meta.get("tool_calls_total")
        if paired is not None and total:
            note += (
                f" Tool results were paired for {paired}/{total} tool calls "
                "via store.db batch-window matching."
            )
        if meta.get("pairing_uncertain"):
            note += (
                " Pairing may be incomplete — counts may differ, or a batch "
                "contained parallel calls with the same tool name (results "
                "paired by name only within each batch window)."
            )
        out += [note, ""]
    return "\n".join(out)


# ------------------------------------------------------- archive (Feature A)


def build_archive(meta, messages, lore_uuid=None):
    """Build the archive as (header dict, list of per-message dicts).

    Full-fidelity, engine-agnostic: one line per message or tool call, raw
    (untruncated) args/results preserved. Flat rather than nesting tool calls
    inside their assistant turn — a lossless 1:1 mapping of the parsed message
    list that is simpler to stream and consume. Absent fields are omitted, not
    null-padded, so a consumer can tell "engine didn't expose this" from "zero".
    """
    header = {
        "schema_version": ARCHIVE_SCHEMA_VERSION,
        "engine": meta.get("engine"),
        "native_session_id": meta.get("session_id"),
        "lore_uuid": lore_uuid,
        "cwd": meta.get("cwd"),
        "title": meta.get("title"),
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    header = {k: v for k, v in header.items() if v is not None}

    lines = []
    for seq, msg in enumerate(messages, 1):
        if "tool" in msg:
            rec = {
                "seq": seq,
                "type": "tool_call",
                "role": msg.get("role", "assistant"),
                "tool": msg.get("tool"),
                "args": msg.get("raw_args", msg.get("args")),
                "result": msg.get("raw_result", msg.get("result")),
            }
        else:
            rec = {
                "seq": seq,
                "type": "message",
                "role": msg.get("role"),
                "text": msg.get("content"),
            }
            if msg.get("model"):
                rec["model"] = msg["model"]
        if msg.get("ts"):
            rec["ts"] = msg["ts"]
        if msg.get("sidechain"):
            rec["sidechain"] = True
        lines.append(rec)
    return header, lines


def write_archive(path, header, lines):
    """Write header + per-message records as gzipped JSONL to path."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with gzip.open(path, "wt", encoding="utf-8") as fh:
        fh.write(json.dumps(header, ensure_ascii=False) + "\n")
        for rec in lines:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")


# ------------------------------------------ session self-identification (A)


def _candidate_logs(engine):
    """(path, [files_to_grep]) for each candidate log of engine, newest first.

    For claude/codex the log file itself carries tool output (where a printed
    UUID lands). For cursor the printed output lives in store.db, not the
    agent-transcript JSONL, so both are grep targets while the JSONL is the
    path handed back for archiving.
    """
    entries = []
    if engine == "claude":
        for p in glob.glob(str(CLAUDE_PROJECTS / "*" / "*.jsonl")):
            entries.append((os.path.getmtime(p), p, [p]))
    elif engine == "codex":
        for p in glob.glob(
            str(CODEX_HOME / "sessions" / "**" / "rollout-*.jsonl"),
            recursive=True,
        ):
            entries.append((os.path.getmtime(p), p, [p]))
    elif engine == "cursor":
        for jsonl in glob.glob(
            str(_cursor_projects() / "*" / "agent-transcripts" / "*" / "*.jsonl")
        ):
            path = Path(jsonl)
            if path.parent.name != path.stem:
                continue
            grep = [jsonl]
            store = cursor_store_db_for_uuid(path.stem)
            if store:
                grep.append(str(store))
            entries.append((os.path.getmtime(jsonl), jsonl, grep))
    entries.sort(key=lambda e: e[0], reverse=True)
    return [(p, g) for _mtime, p, g in entries]


def _file_contains(path, needle):
    try:
        with open(path, "rb") as fh:
            return needle.encode("utf-8") in fh.read()
    except OSError:
        return False


def find_native_log_by_uuid(session_uuid, engine, limit=50):
    """Resolve this session's native log by the lore UUID printed into it.

    Returns (path, confidence) where confidence is "verified" (a candidate
    contained the UUID) or "heuristic" (no match; most-recently-modified log
    for this engine). Returns (None, None) when there are no candidates at all.
    """
    candidates = _candidate_logs(engine)[:limit]
    for path, grep_files in candidates:
        if any(_file_contains(gf, session_uuid) for gf in grep_files):
            return path, "verified"
    if candidates:
        return candidates[0][0], "heuristic"
    return None, None


def _resolve_log_arg(session, engine=None):
    """Turn a CLI session token/path into a concrete log path + engine."""
    path = Path(session)
    if path.suffix == ".db":
        jsonl_path = cursor_jsonl_for_uuid(path.parent.name, strict=True)
        if jsonl_path is None:
            sys.exit(
                f"error: no agent-transcript JSONL found for Cursor chat "
                f"{path.parent.name}"
            )
        path = jsonl_path
    if not path.is_file():
        resolved = resolve_session(session)
        if resolved is None:
            sys.exit(
                f"error: '{session}' is neither a file nor a known session id"
            )
        path = resolved
    eng = engine or detect_engine(path)
    if eng not in PARSERS:
        sys.exit("error: could not detect log format; pass --engine")
    return path, eng


def cmd_archive(argv):
    ap = argparse.ArgumentParser(prog="session-takeover archive")
    ap.add_argument("session", help="session id (prefix ok) or path to a log")
    ap.add_argument("-o", "--output", type=Path, required=True,
                    help="write the gzipped JSONL archive here")
    ap.add_argument("--stats", type=Path,
                    help="also write the usage/cost/model stats JSON here")
    ap.add_argument("--lore-uuid",
                    help="lore session UUID to stamp into the archive header")
    ap.add_argument("--engine", choices=sorted(PARSERS),
                    help="force log format instead of auto-detecting")
    a = ap.parse_args(argv)

    path, engine = _resolve_log_arg(a.session, a.engine)
    meta, messages = PARSERS[engine](path)
    if not messages:
        sys.exit("error: no conversation messages found in log")

    header, lines = build_archive(meta, messages, a.lore_uuid)
    write_archive(a.output, header, lines)
    turns = sum(1 for m in messages if "tool" not in m)
    print(
        f"wrote {a.output} ({turns} messages, "
        f"{len(messages) - turns} tool calls, engine: {engine})"
    )

    if a.stats:
        stats = compute_stats(meta, messages)
        # Include the archive locator so the summarize step can assemble the
        # `archive:` frontmatter block straight from this one JSON.
        stats["archive"] = {
            "path": str(a.output),
            "schema_version": ARCHIVE_SCHEMA_VERSION,
        }
        a.stats.write_text(json.dumps(stats, indent=2, ensure_ascii=False))
        print(f"wrote {a.stats}")
    return 0


# -------------------------------------------------------------------- main


def cmd_list(engines, limit, include_all=False):
    for engine in engines:
        sessions = LISTERS[engine](limit, include_all)
        print(f"== {engine} ({len(sessions)} session(s)) ==")
        for s in sessions:
            cwd = f"  cwd: {s['cwd']}" if s.get("cwd") else ""
            extras = []
            if s.get("model"):
                extras.append(s["model"])
            if s.get("status"):
                extras.append(s["status"])
            if s.get("is_subagent"):
                extras.append("subagent")
            tag = f"  [{', '.join(extras)}]" if extras else ""
            print(f"{_fmt_ts(s['updated'])}  {s['id'][:12]}  {s['title']}{tag}{cwd}")
            print(f"    {s['path']}")
        print()


def main():
    # `archive` is a sub-verb with its own argument grammar; dispatch before
    # the main parser so the takeover flags don't collide with it.
    if sys.argv[1:2] == ["archive"]:
        sys.exit(cmd_archive(sys.argv[2:]))

    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("session", nargs="?",
                    help="session id (prefix ok) or path to an engine log")
    ap.add_argument("--list", action="store_true",
                    help="list recent sessions across engines")
    ap.add_argument("--find-by-uuid",
                    help="resolve this session's native log by a UUID printed "
                         "into its transcript (requires --engine); prints the "
                         "path, or exits non-zero if no candidate logs exist")
    ap.add_argument("--engine", choices=sorted(LISTERS),
                    help="limit --list / force log format")
    ap.add_argument("--limit", type=int, default=None,
                    help="max sessions per engine (--list default 10, "
                         "--find-by-uuid default 50)")
    ap.add_argument("--all", action="store_true",
                    help="include temp-dir (test-fixture) sessions in --list")
    ap.add_argument("-o", "--output", type=Path,
                    help="write digest here (default: stdout)")
    ap.add_argument("--json", type=Path,
                    help="also dump the unified message list as JSON")
    args = ap.parse_args()

    if args.find_by_uuid:
        if not args.engine:
            sys.exit("error: --find-by-uuid requires --engine")
        path, confidence = find_native_log_by_uuid(
            args.find_by_uuid, args.engine, args.limit or 50
        )
        if path is None:
            sys.exit(1)  # no candidate logs at all — caller warns and skips
        if confidence == "heuristic":
            sys.stderr.write(
                "warning: no candidate log contained the UUID; falling back "
                "to the most-recently-modified log for this engine\n"
            )
        print(path)
        return

    if args.list:
        cmd_list([args.engine] if args.engine else sorted(LISTERS),
                 args.limit or 10, args.all)
        return
    if not args.session:
        sys.exit("error: pass a session id/path, or --list")

    path = Path(args.session)
    if path.suffix == ".db":
        jsonl_path = cursor_jsonl_for_uuid(path.parent.name, strict=True)
        if jsonl_path is None:
            sys.exit(
                f"error: no agent-transcript JSONL found for Cursor chat {path.parent.name}"
            )
        path = jsonl_path
    if not path.is_file():
        path = resolve_session(args.session)
        if path is None:
            sys.exit(
                f"error: '{args.session}' is neither a file nor a known "
                "session id — try --list"
            )

    engine = args.engine or detect_engine(path)
    if engine not in PARSERS:
        sys.exit("error: could not detect log format; pass --engine")

    meta, messages = PARSERS[engine](path)
    if not messages:
        sys.exit("error: no conversation messages found in log")

    if args.json:
        args.json.write_text(
            json.dumps(
                {"meta": meta, "messages": messages}, indent=2, ensure_ascii=False
            )
        )

    digest = render_markdown(meta, messages)
    if args.output:
        args.output.write_text(digest)
        # Count only digest-visible messages (sidechains are archived, not shown)
        shown = [m for m in messages if not m.get("sidechain")]
        turns = sum(1 for m in shown if "tool" not in m)
        print(
            f"wrote {args.output} ({turns} conversation turns, "
            f"{len(shown) - turns} tool calls, engine: {engine})"
        )
    else:
        print(digest)


if __name__ == "__main__":
    main()
