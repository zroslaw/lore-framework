#!/usr/bin/env python3
"""Generate .cursor-skills/lr-*/SKILL.md wrappers from canonical skills/*/SKILL.md.

Cursor uses the skill folder name in the picker (no plugin namespace like Claude's /lr:).
Each wrapper is a thin pointer with lr- prefixed identity; logic stays in docs/*.md.

Run from the framework root after adding or renaming a canonical skill:
  python3 scripts/sync-cursor-skills
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILLS = ROOT / "skills"
CURSOR = ROOT / ".cursor-skills"
LEGACY_CURSOR = SKILLS / "cursor"


def transform_description(desc: str, skill_name: str) -> str:
    or_skill = f"lr-{skill_name}"
    desc = re.sub(rf"/lr:{re.escape(skill_name)}\b", f"/{or_skill}", desc)
    desc = re.sub(r"/lr:([\w-]+)", r"/lr-\1", desc)
    return desc


def parse_skill(content: str) -> tuple[list[str], str]:
    lines = content.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError("SKILL.md missing YAML frontmatter")
    fm: list[str] = []
    i = 1
    while i < len(lines):
        if lines[i].strip() == "---":
            return fm, "".join(lines[i + 1 :]).lstrip("\n")
        fm.append(lines[i])
        i += 1
    raise ValueError("SKILL.md frontmatter not closed")


def rebuild_frontmatter(fm: list[str], skill_name: str) -> list[str]:
    lr_name = f"lr-{skill_name}"
    out: list[str] = [f"name: {lr_name}\n"]
    seen_name = False
    for line in fm:
        if line.startswith("name:"):
            seen_name = True
            continue
        if line.startswith("description:"):
            rest = line[len("description:") :].strip()
            if rest.startswith('"') and rest.endswith('"'):
                inner = transform_description(rest[1:-1], skill_name)
                out.append(f'description: "{inner}"\n')
            else:
                out.append(line)
            continue
        out.append(line)
    if seen_name:
        out[0] = f"name: {lr_name}\n"
    return out


def transform_body(body: str, skill_name: str, cursor_rel: str) -> str:
    canonical_rel = f"skills/{skill_name}/SKILL.md"
    body = body.replace(canonical_rel, cursor_rel)
    return body


def wrapper_content(skill_name: str) -> str:
    src = SKILLS / skill_name / "SKILL.md"
    fm, body = parse_skill(src.read_text())
    lr_name = f"lr-{skill_name}"
    cursor_rel = f".cursor-skills/{lr_name}/SKILL.md"
    new_fm = rebuild_frontmatter(fm, skill_name)
    new_body = transform_body(body, skill_name, cursor_rel)
    return f"---\n{''.join(new_fm)}---\n\n{new_body}"


def expected_wrappers(names: list[str]) -> dict[Path, str]:
    return {
        CURSOR / f"lr-{name}" / "SKILL.md": wrapper_content(name)
        for name in names
    }


def check_wrappers(expected: dict[Path, str]) -> int:
    """Report wrapper drift without creating, rewriting, or deleting anything."""
    issues: list[str] = []
    for path, content in expected.items():
        if not path.is_file():
            issues.append(f"missing {path.relative_to(ROOT)}")
        elif path.read_text() != content:
            issues.append(f"out of date {path.relative_to(ROOT)}")
    if CURSOR.is_dir():
        expected_dirs = {path.parent.name for path in expected}
        for child in CURSOR.iterdir():
            if child.is_dir() and child.name not in expected_dirs:
                issues.append(f"stale {child.relative_to(ROOT)}")
    if LEGACY_CURSOR.exists():
        issues.append(f"legacy {LEGACY_CURSOR.relative_to(ROOT)}")
    if issues:
        for issue in issues:
            print(issue)
        print("Cursor skill wrappers are out of sync; run scripts/sync-cursor-skills.")
        return 1
    print("Cursor skill wrappers are in sync.")
    return 0


def sync_wrappers(expected: dict[Path, str]) -> None:
    CURSOR.mkdir(parents=True, exist_ok=True)
    for path, content in expected.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(f"synced {path.relative_to(ROOT)}")
    expected_dirs = {path.parent.name for path in expected}
    for child in CURSOR.iterdir():
        if child.is_dir() and child.name not in expected_dirs:
            import shutil

            shutil.rmtree(child)
            print(f"removed stale {child.relative_to(ROOT)}")
    if LEGACY_CURSOR.exists():
        import shutil

        shutil.rmtree(LEGACY_CURSOR)
        print(f"removed legacy {LEGACY_CURSOR.relative_to(ROOT)}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true",
                        help="report wrapper drift without modifying the tree")
    args = parser.parse_args(argv)
    if not SKILLS.is_dir():
        print(f"error: missing {SKILLS}", file=sys.stderr)
        return 1
    names = sorted(p.name for p in SKILLS.iterdir() if p.is_dir() and (p / "SKILL.md").is_file())
    if not names:
        print("error: no canonical skills found", file=sys.stderr)
        return 1
    expected = expected_wrappers(names)
    if args.check:
        return check_wrappers(expected)
    sync_wrappers(expected)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
