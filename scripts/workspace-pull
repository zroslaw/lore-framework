#!/usr/bin/env bash
# workspace-pull — pull fresh workspace state across two levels of repo declarations.
#
# Phases:
#   0  Pull the workspace root itself, if it is a git repo with an origin remote
#      (dirty-tree guarded, never fatal).
#   1  Read <workspace>/lore-workspace.md `repos:` (workspace-level layout) and clone
#      any declared repos not yet present.
#   2  Discover every <subdir>/lore-repo.md, merge each `repos:` (domain-level
#      dependencies), and clone any not already satisfied by phase 1.
#   3  When the workspace root is git-tracked, append standard workspace-owned
#      ignore lines (/.worktrees/, /.lr-beings/, /.tmp/) plus a `/child/` line for
#      every declared repo present on disk (idempotent; never auto-commits).
#   4  Pull every top-level git repo (existing + freshly cloned) in parallel.
#
# Phase 1 must complete before phase 2: domain descriptors live inside the
# workspace-level agent repos, so those repos must be on disk before discovery.
#
# Usage: workspace-pull [WORKSPACE_DIR]
#
# Exit codes:
#   0  success — nothing to do, or every clone/pull succeeded with no conflicts
#   1  one or more clone/pull failures or conflicts requiring manual resolution
#   2  invalid invocation (workspace dir missing or not a directory)
#
# Phase 0 warnings (dirty tree, network) never set exit 1 on their own.
#
# Compatibility: written for Bash 3.2+ (default on macOS) — no associative arrays.

set -uo pipefail

# Disable interactive credential prompts. Parallel git invocations sharing a
# single TTY would otherwise garble each other's prompts. Failures surface
# cleanly in the per-repo report.
export GIT_TERMINAL_PROMPT=0
# GIT_TERMINAL_PROMPT=0 covers only Git's own HTTP(S) prompt, not SSH. For SSH
# remotes, append BatchMode (an unknown host key or passphrase prompt becomes an
# immediate failure — parallel jobs can't answer prompts anyway) and
# ConnectTimeout (bounds the connect), preserving any GIT_SSH_COMMAND the user set.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=10"

# ----------------------------------------------------------------------------
# Workspace
# ----------------------------------------------------------------------------

WORKSPACE_INPUT="${1:-.}"

if [[ ! -d "$WORKSPACE_INPUT" ]]; then
  echo "workspace-pull: not a directory: $WORKSPACE_INPUT" >&2
  exit 2
fi

WORKSPACE="$(cd "$WORKSPACE_INPUT" && pwd)"

# ----------------------------------------------------------------------------
# Colors (only when stdout is a tty)
# ----------------------------------------------------------------------------

if [[ -t 1 ]]; then
  C_NAME=$'\033[0;34m'
  C_OK=$'\033[0;32m'
  C_FAIL=$'\033[0;31m'
  C_WARN=$'\033[0;33m'
  C_DIM=$'\033[2m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  C_NAME=''; C_OK=''; C_FAIL=''; C_WARN=''; C_DIM=''; BOLD=''; RESET=''
fi

# ----------------------------------------------------------------------------
# YAML extraction (constrained schema)
#
# We accept block-form `repos:` only:
#
#     repos:
#       - <url-1>
#       - <url-2>
#
# Inline forms (`repos: [a, b]`), nested keys, anchors, and merge keys are not
# supported. Comments and blank lines inside the frontmatter are ignored.
# The same parser reads both lore-workspace.md and lore-repo.md.
# ----------------------------------------------------------------------------

parse_repos_field() {
  local file="$1"
  awk '
    BEGIN { fm = 0; repos = 0 }

    {
      # Strip UTF-8 BOM from the very first line, if present.
      if (NR == 1) {
        if (substr($0, 1, 3) == "\357\273\277") $0 = substr($0, 4)
      }
      # Strip trailing CR (CRLF line endings).
      sub(/\r$/, "", $0)
    }

    # Frontmatter must open on line 1 (after optional BOM). If the first line
    # is not the opening `---`, this file has no frontmatter — bail.
    NR == 1 {
      if ($0 ~ /^---[[:space:]]*$/) {
        fm = 1
        next
      } else {
        exit
      }
    }

    # Closing `---`: stop parsing.
    /^---[[:space:]]*$/ {
      if (fm == 1) {
        fm = 2
        exit
      }
      next
    }

    # Defensive: only act inside frontmatter (always true once line 1 opened it).
    fm != 1 { next }

    # Skip blank lines and comment lines anywhere in frontmatter.
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }

    # Inside repos block: capture list items, exit on non-list line.
    repos == 1 {
      if ($0 ~ /^[[:space:]]+-/) {
        line = $0
        sub(/^[[:space:]]+-[[:space:]]*/, "", line)

        # Quote-aware comment stripping: only strip `#` outside surrounding quotes.
        # If the value is quoted, leave its content alone; otherwise strip from
        # the first ` #` onward.
        first_char = substr(line, 1, 1)
        if (first_char != "\"" && first_char != "'"'"'") {
          sub(/[[:space:]]+#.*$/, "", line)
        }
        sub(/[[:space:]]+$/, "", line)

        # Strip surrounding quotes if present.
        if (length(line) > 1 \
            && substr(line, 1, 1) == "\"" \
            && substr(line, length(line), 1) == "\"") {
          line = substr(line, 2, length(line) - 2)
        } else if (length(line) > 1 \
            && substr(line, 1, 1) == "'"'"'" \
            && substr(line, length(line), 1) == "'"'"'") {
          line = substr(line, 2, length(line) - 2)
        }

        if (length(line) > 0) print line
        next
      }
      repos = 0
    }

    # Detect start of repos block (block form only).
    /^repos:[[:space:]]*$/ { repos = 1; next }

    # End-of-file: warn if frontmatter was opened but never closed (fm==1
    # means we hit EOF mid-frontmatter; fm==2 means we saw the closing `---`).
    END {
      if (fm == 1) {
        print "workspace-pull: warning: '"'"'" FILENAME "'"'"' has no closing --- after frontmatter; results may be incomplete" > "/dev/stderr"
      }
    }
  ' "$file"
}

# ----------------------------------------------------------------------------
# URL helpers
# ----------------------------------------------------------------------------

# Derive a directory name from a remote URL.
#
#   git@github.com:foo/bar.git    -> bar
#   https://github.com/foo/bar.git -> bar
#   https://github.com/foo/bar     -> bar
#   ssh://git@host/foo/bar.git    -> bar
#
# Returns the empty string if the derived name is unsafe (path-traversal,
# starts with `-`, contains a slash, or contains a gitignore metacharacter).
# The caller is responsible for treating an empty result as a conflict.
url_to_dir() {
  local url="$1"
  url="${url%/}"               # strip optional trailing slash
  local name="${url##*[:/]}"   # everything after the last `:` or `/`
  name="${name%.git}"          # strip optional `.git` suffix

  # Reject names that would escape the workspace or be parsed as flags.
  #
  # The leading-dot rule covers more than `.` and `..`: the scanner's
  # `scan_children` skips dot-directories, and the `*/` globs below never match
  # them either. Cloning `.hidden` would produce a repo that this script pulls
  # once and then never sees again — absent from `.gitignore` maintenance, and
  # reported missing forever by S6. `derive_dirname` in `lr_core/workspace_scan.py`
  # refuses the same names; these two must agree or the scan and the pull
  # disagree about which repos exist.
  case "$name" in
    ''|.*|-*) printf ''; return 0 ;;
  esac
  # Reject any slash (path traversal via crafted URL), and any backslash, which
  # `derive_dirname` also refuses: `\` is an escape character in `.gitignore`,
  # so a `/foo\bar/` line does not match the directory it was written for.
  if [[ "$name" == */* || "$name" == *\\* ]]; then
    printf ''
    return 0
  fi
  # Reject gitignore metacharacters. A dir name carrying `*`, `?`, `[`, or a
  # leading `!` would turn a phase-3 `.gitignore` line into a pattern or a
  # negation — defense in depth (git hosts don't allow these in repo names).
  case "$name" in
    '!'*|*'*'*|*'?'*|*'['*) printf ''; return 0 ;;
  esac

  printf '%s' "$name"
}

# Normalize a URL for equality comparison: strip trailing `/` and `.git`.
normalize_url() {
  local u="$1"
  u="${u%/}"
  u="${u%.git}"
  printf '%s' "$u"
}

urls_match() {
  [[ "$(normalize_url "$1")" == "$(normalize_url "$2")" ]]
}

# Scrub control characters from a string before displaying it. Defends against
# ANSI-escape injection via hostile descriptor URLs.
display_scrub() {
  printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}

# ----------------------------------------------------------------------------
# Phase 0 — Pull the workspace root itself (conditional)
# ----------------------------------------------------------------------------
#
# Only when the workspace root is a git repo AND has an origin remote. Guarded
# by a dirty-tree check so an in-progress edit is never clobbered. Any failure
# here is a warning, never fatal — phases 1-4 proceed against the local files.

phase0_state="skipped"   # skipped | pulled | warned

if [[ -d "$WORKSPACE/.git" || -f "$WORKSPACE/.git" ]] \
   && git -C "$WORKSPACE" remote get-url origin >/dev/null 2>&1; then
  # Dirty = any staged or unstaged tracked change. --ff-only would refuse to
  # clobber it anyway; we skip explicitly so the warning is legible.
  if [[ -n "$(git -C "$WORKSPACE" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
    echo "${C_WARN}Phase 0: workspace root has uncommitted changes — skipping root pull, using local files.${RESET}" >&2
    phase0_state="warned"
    # Say HOW STALE the local files are, not just that we skipped. A silent
    # skip is indistinguishable from a successful pull in the summary, so a
    # workspace that is 12 commits behind reads as current — which is exactly
    # the state /lr:workspace-status reports as S14. Fetch first (refs only, no
    # working-tree change, safe on a dirty tree), then count.
    if git -C "$WORKSPACE" fetch --quiet origin >/dev/null 2>&1 \
       && upstream="$(git -C "$WORKSPACE" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" \
       && [[ -n "$upstream" ]]; then
      behind="$(git -C "$WORKSPACE" rev-list --count "HEAD..$upstream" 2>/dev/null || echo "")"
      if [[ -n "$behind" && "$behind" != "0" ]]; then
        echo "${C_WARN}Phase 0: workspace root is $behind commit(s) behind $upstream — commit or stash, then re-run.${RESET}" >&2
        phase0_state="warned ($behind behind)"
      else
        phase0_state="warned (up to date)"
      fi
    else
      echo "${C_WARN}Phase 0: could not determine how far behind the workspace root is (no upstream, or fetch failed).${RESET}" >&2
      phase0_state="warned (behind-ness unknown)"
    fi
  else
    if git -C "$WORKSPACE" pull --ff-only >/dev/null 2>&1; then
      phase0_state="pulled"
    else
      echo "${C_WARN}Phase 0: workspace root 'git pull --ff-only' failed (network, auth, or diverged history) — proceeding with local files.${RESET}" >&2
      phase0_state="warned"
    fi
  fi
fi

# ----------------------------------------------------------------------------
# Declaration set (shared across phases 1 and 2)
#
# Parallel arrays (Bash 3.2 compat — no associative arrays):
#   declared_urls[i]    — the URL
#   declared_sources[i] — descriptor file that first declared it
#   declared_levels[i]  — "workspace" | "domain" (for reporting only)
# ----------------------------------------------------------------------------

declared_urls=()
declared_sources=()
declared_levels=()

already_declared() {
  local needle="$1"
  [[ ${#declared_urls[@]} -eq 0 ]] && return 1
  local u
  for u in "${declared_urls[@]}"; do
    [[ "$u" == "$needle" ]] && return 0
  done
  return 1
}

source_for_url() {
  local needle="$1"
  local i
  for i in "${!declared_urls[@]}"; do
    [[ "${declared_urls[$i]}" == "$needle" ]] && { printf '%s' "${declared_sources[$i]}"; return 0; }
  done
  return 1
}

# ----------------------------------------------------------------------------
# Classification: clone / already-present / conflict, with dir-collision guard.
# Populates to_clone_* (pending clones) and conflicts/collisions. Shared across
# both levels so a URL cloned at the workspace level is never re-cloned at the
# domain level (union dedupe by URL happens before classify via already_declared).
# ----------------------------------------------------------------------------

claimed_dirs=()
claimed_urls=()

claim_for_dir() {
  local needle="$1"
  local i
  for i in "${!claimed_dirs[@]}"; do
    [[ "${claimed_dirs[$i]}" == "$needle" ]] && { printf '%s' "${claimed_urls[$i]}"; return 0; }
  done
  return 1
}

collisions=()
to_clone_url=()
to_clone_dir=()
conflicts=()

# Dirs to skip during the pull phase (remote-mismatch, not-a-repo, missing
# origin, etc.). We can't trust a `git pull` against an unexpected remote.
skip_pull_dirs=()

mark_skip_pull() { skip_pull_dirs+=("$1"); }

is_skip_pull() {
  local needle="$1"
  [[ ${#skip_pull_dirs[@]} -eq 0 ]] && return 1
  local d
  for d in "${skip_pull_dirs[@]}"; do
    [[ "$d" == "$needle" ]] && return 0
  done
  return 1
}

# Dirs that are present-and-consistent (cloned this run or already correct) —
# eligible for phase-3 gitignore. Built as classification proceeds.
present_dirs=()

classify_url() {
  local url="$1"
  local dir
  dir="$(url_to_dir "$url")"

  if [[ -z "$dir" ]]; then
    conflicts+=("(unsafe or unparseable URL — refusing to derive directory name: $(display_scrub "$url"))")
    return
  fi

  # Collision: another distinct URL already claims this dir.
  local existing_claim
  existing_claim="$(claim_for_dir "$dir" || true)"
  if [[ -n "$existing_claim" ]] && ! urls_match "$existing_claim" "$url"; then
    collisions+=("dir '$dir' claimed by both '$(display_scrub "$existing_claim")' and '$(display_scrub "$url")' → rename one of them in its descriptor")
    return
  fi
  if [[ -z "$existing_claim" ]]; then
    claimed_dirs+=("$dir")
    claimed_urls+=("$url")
  fi

  local target="$WORKSPACE/$dir"
  local src
  src="$(source_for_url "$url" || true)"
  if [[ -L "$target" ]]; then
    conflicts+=("$dir: '$target' is a symlink — refusing to touch (declared in $src) → remove the symlink and rerun")
    mark_skip_pull "$dir"
  elif [[ ! -e "$target" ]]; then
    to_clone_url+=("$url")
    to_clone_dir+=("$dir")
    present_dirs+=("$dir")   # will exist after the clone phase
  elif [[ ! -d "$target" ]]; then
    conflicts+=("$dir: '$target' exists but is not a directory (declared in $src) → rename or remove the file and rerun")
    mark_skip_pull "$dir"
  elif [[ ! -d "$target/.git" && ! -f "$target/.git" ]]; then
    conflicts+=("$dir: '$target' exists but is not a git repository (declared in $src) → rename or remove the directory and rerun")
    mark_skip_pull "$dir"
  else
    local actual_remote
    actual_remote="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
    if [[ -z "$actual_remote" ]]; then
      conflicts+=("$dir: no 'origin' remote configured (declared as '$(display_scrub "$url")' in $src) → git -C $dir remote add origin <url>")
      mark_skip_pull "$dir"
    elif ! urls_match "$actual_remote" "$url"; then
      conflicts+=("$dir: declared '$(display_scrub "$url")' but local origin is '$(display_scrub "$actual_remote")' (declared in $src) → reconcile the descriptor or run: git -C $dir remote set-url origin <url>")
      mark_skip_pull "$dir"
    else
      present_dirs+=("$dir")   # already present and consistent
    fi
  fi
}

# ----------------------------------------------------------------------------
# Working tmpdir for capturing per-repo output and exit codes
# ----------------------------------------------------------------------------

tmpdir="$(mktemp -d 2>/dev/null || mktemp -d -t 'workspace-pull')"

# shellcheck disable=SC2329  # invoked indirectly via trap
cleanup_tmp() { rm -rf "$tmpdir"; }
# shellcheck disable=SC2329  # invoked indirectly via trap
# A clone subshell cleans up its own partial target when `git clone` fails, but
# on INT/TERM it is killed as part of this process group and never reaches that
# line. Each in-flight clone therefore records its target here, and the signal
# handler removes what the subshells could not — otherwise Ctrl-C mid-clone
# leaves a half-written directory that the next run can only report as a
# conflict.
cleanup_inflight() {
  local f target
  for f in "$tmpdir"/inflight-*; do
    [[ -e "$f" ]] || continue
    target="$(cat "$f" 2>/dev/null || true)"
    # Only ever remove inside the workspace, and only a path we wrote here.
    [[ -n "$target" && "$target" == "$WORKSPACE"/* && -d "$target" ]] || continue
    # A marker means this run created this directory and never confirmed it
    # finished, so it is disposable: nothing of the user's can be inside it, and
    # re-cloning is lossless. Do not try to tell a finished clone from an
    # interrupted one — `git clone` resolves HEAD before it finishes checking out
    # the working tree, so every cheap test either preserves a truncated tree
    # (which `classify_url` would then trust forever) or deletes a good one.
    # Deleting a few seconds of download beats keeping a repo that only looks
    # complete.
    rm -rf "$target"
  done
}
# shellcheck disable=SC2329  # invoked indirectly via trap
cleanup_signal() {
  trap - INT
  # Deafen this shell to its own broadcast before sending it. `kill -- -$$`
  # includes the sender, so with TERM reset to its default the handler's own
  # survival depends on bash's signal-delivery timing — and the two lines that
  # matter (removing partial clones, removing the tmpdir) come after the kill.
  # Ignoring TERM across the broadcast removes the question: children take the
  # default action and die, this handler runs to completion either way.
  trap '' TERM
  kill -- -$$ 2>/dev/null || kill 0 2>/dev/null || true
  cleanup_inflight
  cleanup_tmp
  trap - TERM
  exit 130
}
trap cleanup_tmp EXIT
trap cleanup_signal INT TERM

# Build a tmpfile key that is unique per parallel slot. Combines a sanitized
# form of the dir name (for human-readable diagnostics) with the slot index
# (for guaranteed uniqueness — prevents collisions like `foo bar` vs `foo_bar`).
safe_key() {
  local s="$1"
  local idx="$2"
  s="${s//\//_}"
  s="$(printf '%s' "$s" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')"
  printf '%s-%s' "$idx" "$s"
}

clone_ok=0
clone_fail=0
clone_failures=()

# Clone every pending entry in to_clone_* whose index is >= the given start
# offset, in parallel. Lets phase 1 clone its batch, then phase 2 clone only the
# entries it appended.
run_clone_batch() {
  local start="$1"
  local total=${#to_clone_url[@]}
  [[ $start -ge $total ]] && return 0

  local count=$(( total - start ))
  echo "${BOLD}Cloning ${count} repo(s) in parallel...${RESET}"
  echo ""

  local pids=() i url dir target key ec
  for (( i = start; i < total; i++ )); do
    url="${to_clone_url[$i]}"
    dir="${to_clone_dir[$i]}"
    target="$WORKSPACE/$dir"
    key="$(safe_key "$dir" "$i")"
    printf '%s' "$target" >"$tmpdir/inflight-$key"
    (
      # `--` terminates option parsing so a hostile URL starting with `-` is
      # treated as a positional argument (URL), not a git flag.
      LC_ALL=C git clone -- "$url" "$target" >"$tmpdir/clone-$key.out" 2>&1
      ec=$?
      # Drop the marker the instant `git clone` returns — before any other work.
      # Anything after this point is no longer an interruptible clone, and a signal
      # arriving here must not send the handler after a target that is now complete.
      rm -f "$tmpdir/inflight-$key"
      echo $ec >"$tmpdir/clone-$key.exit"
      # Clean up partial clones so the next run doesn't see them as conflicts.
      if [[ $ec -ne 0 && -d "$target" ]]; then
        rm -rf "$target"
      fi
    ) &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do wait "$pid" || true; done

  local code reason
  for (( i = start; i < total; i++ )); do
    url="${to_clone_url[$i]}"
    dir="${to_clone_dir[$i]}"
    key="$(safe_key "$dir" "$i")"
    code="$(cat "$tmpdir/clone-$key.exit" 2>/dev/null || echo "?")"
    if [[ "$code" == "0" ]]; then
      echo "  ${C_OK}✓${RESET} ${BOLD}${dir}${RESET} ${C_DIM}cloned from $(display_scrub "$url")${RESET}"
      clone_ok=$((clone_ok + 1))
    else
      reason="$(grep -E '^(fatal|error):' "$tmpdir/clone-$key.out" 2>/dev/null | tail -1)"
      [[ -z "$reason" ]] && reason="$(tail -1 "$tmpdir/clone-$key.out" 2>/dev/null)"
      [[ -z "$reason" ]] && reason="unknown error"
      reason="$(display_scrub "$reason")"
      echo "  ${C_FAIL}✗${RESET} ${BOLD}${dir}${RESET} ${C_DIM}failed to clone — ${reason}${RESET}"
      clone_failures+=("$dir <- $(display_scrub "$url"): $reason")
      clone_fail=$((clone_fail + 1))
    fi
  done
  echo ""
}

# ----------------------------------------------------------------------------
# Phase 1 — Workspace-level repos (lore-workspace.md)
# ----------------------------------------------------------------------------

WS_DESCRIPTOR="$WORKSPACE/lore-workspace.md"
ws_url_count=0

if [[ -f "$WS_DESCRIPTOR" ]]; then
  while IFS= read -r url; do
    [[ -z "$url" ]] && continue
    if ! already_declared "$url"; then
      declared_urls+=("$url")
      declared_sources+=("$WS_DESCRIPTOR")
      declared_levels+=("workspace")
      classify_url "$url"
      ws_url_count=$((ws_url_count + 1))
    fi
  done < <(parse_repos_field "$WS_DESCRIPTOR")
fi

ws_clone_fail_before=$clone_fail
run_clone_batch 0
ws_clone_failed=$(( clone_fail - ws_clone_fail_before ))
domain_clone_start=${#to_clone_url[@]}

# ----------------------------------------------------------------------------
# Phase 2 — Domain-level repos (each <subdir>/lore-repo.md)
#
# Runs after phase 1's clones so agent repos declared at the workspace level are
# on disk and their lore-repo.md descriptors are discoverable.
# ----------------------------------------------------------------------------

descriptors=()
for f in "$WORKSPACE"/*/lore-repo.md; do
  [[ -f "$f" ]] || continue
  # Skip descriptors reached through a symlinked top-level dir.
  d="$(dirname "$f")"
  [[ -L "$d" ]] && continue
  descriptors+=("$f")
done

if [[ ${#descriptors[@]} -gt 0 ]]; then
  for fm_file in "${descriptors[@]}"; do
    while IFS= read -r url; do
      [[ -z "$url" ]] && continue
      if ! already_declared "$url"; then
        declared_urls+=("$url")
        declared_sources+=("$fm_file")
        declared_levels+=("domain")
        classify_url "$url"
      fi
    done < <(parse_repos_field "$fm_file")
  done
fi

run_clone_batch "$domain_clone_start"

# Partial phase-1 warning: agent repos that failed to clone may hide domain
# `repos:` declarations we never discovered.
if [[ $ws_clone_failed -gt 0 ]]; then
  echo "${C_WARN}Note: ${ws_clone_failed} workspace-level clone(s) failed. Domain-level repos declared inside those missing repos were not discovered — fix the clone failures and re-run.${RESET}" >&2
  echo "" >&2
fi

# ----------------------------------------------------------------------------
# Phase 3 — .gitignore plumbing (only when the workspace root is git-tracked)
#
# Append the standard workspace-owned ignore lines, then a `/child/` line for
# every declared repo present on disk (cloned this run or already consistent).
# Idempotent by exact-line match; never auto-commits.
# ----------------------------------------------------------------------------

gitignore_added=0

if [[ -d "$WORKSPACE/.git" || -f "$WORKSPACE/.git" ]]; then
  gitignore="$WORKSPACE/.gitignore"
  if [[ ! -e "$gitignore" ]]; then
    printf '# Child repositories — managed by /lr:workspace-pull (lore-framework v25+)\n' > "$gitignore"
    printf '# Do not commit nested repo contents into the workspace repo.\n\n' >> "$gitignore"
  fi
  # Standard workspace-owned dirs (seeded by workspace-init; maintained here too).
  for line in "/.worktrees/" "/.lr-beings/" "/.tmp/"; do
    if ! grep -qxF "$line" "$gitignore" 2>/dev/null; then
      printf '%s\n' "$line" >> "$gitignore"
      gitignore_added=$((gitignore_added + 1))
    fi
  done
  # Every child git repo on disk gets an ignore line, declared or not.
  # Declaration governs cloning and pulling; ignoring governs safety, and an
  # undeclared clone can have its contents committed into the workspace repo
  # just as easily as a declared one. Ignoring only the declared set is how a
  # hand-cloned child came to need a manually-added .gitignore line.
  #
  # A name taken from the FILESYSTEM must pass the same metacharacter filter
  # url_to_dir applies to a name derived from a URL. A directory literally
  # named `!notes` or `logs*` is creatable locally even though no git host
  # would allow it as a repo name, and writing `/!notes/` into .gitignore turns
  # the line into a negation that un-ignores something else. Skip and warn
  # instead — an unignored child is a visible problem, a corrupted .gitignore
  # is a silent one.
  ign_dirs=("${present_dirs[@]:-}")
  for d in "$WORKSPACE"/*/; do
    d="${d%/}"
    [[ -L "$d" ]] && continue
    [[ -d "$d/.git" || -f "$d/.git" ]] || continue
    ign_name="$(basename "$d")"
    case "$ign_name" in
      '!'*|*'*'*|*'?'*|*'['*|-*)
        echo "${C_WARN}Phase 3: child repo '$ign_name' has a name unsafe for .gitignore — not ignored; rename it or add a quoted rule by hand.${RESET}" >&2
        continue
        ;;
    esac
    ign_dirs+=("$ign_name")
  done
  # De-dupe, then append any missing exact `/dir/` line.
  seen_ign=""
  for dir in "${ign_dirs[@]:-}"; do
    [[ -z "$dir" ]] && continue
    case "$seen_ign" in *"|$dir|"*) continue ;; esac
    seen_ign="$seen_ign|$dir|"
    line="/$dir/"
    if ! grep -qxF "$line" "$gitignore" 2>/dev/null; then
      printf '%s\n' "$line" >> "$gitignore"
      gitignore_added=$((gitignore_added + 1))
    fi
  done
fi

# ----------------------------------------------------------------------------
# Phase 4 — Pull all top-level git repos (existing + newly cloned).
# Output is streamed with a [name] prefix in real-time. --ff-only so divergent
# local branches surface as conflicts rather than silent merge commits.
# ----------------------------------------------------------------------------

top_level_repos=()
for d in "$WORKSPACE"/*/; do
  d="${d%/}"
  # Skip symlinked dirs — don't pull a repo that lives outside the workspace.
  [[ -L "$d" ]] && continue
  name="$(basename "$d")"
  if [[ -d "$d/.git" || -f "$d/.git" ]]; then
    if is_skip_pull "$name"; then
      continue   # remote-mismatch or other conflict — surfaced in the conflicts report.
    fi
    top_level_repos+=("$name")
  fi
done

pull_ok=0
pull_fail=0
pull_failures=()

if [[ ${#top_level_repos[@]} -gt 0 ]]; then
  echo "${BOLD}Pulling ${#top_level_repos[@]} repo(s) in parallel...${RESET}"
  echo ""

  pids=()
  for i in "${!top_level_repos[@]}"; do
    name="${top_level_repos[$i]}"
    repo="$WORKSPACE/$name"
    key="$(safe_key "$name" "$i")"
    (
      { LC_ALL=C git -C "$repo" pull --ff-only 2>&1; echo $? >"$tmpdir/pull-$key.exit"; } \
        | tee "$tmpdir/pull-$key.out" \
        | while IFS= read -r line; do
            printf "%s[%-30s]%s %s\n" "$C_NAME" "$name" "$RESET" "$line"
          done
    ) &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do wait "$pid" || true; done
  echo ""

  for i in "${!top_level_repos[@]}"; do
    name="${top_level_repos[$i]}"
    key="$(safe_key "$name" "$i")"
    code="$(cat "$tmpdir/pull-$key.exit" 2>/dev/null || echo "?")"
    out="$tmpdir/pull-$key.out"

    if [[ "$code" == "0" ]] && grep -q "Already up to date" "$out" 2>/dev/null; then
      note="already up to date"
    elif [[ "$code" == "0" ]]; then
      note="$(grep -E '[0-9]+ file' "$out" 2>/dev/null | head -1)"
      [[ -z "$note" ]] && note="updated"
    else
      note="$(grep -E '^(fatal|error):' "$out" 2>/dev/null | tail -1)"
      [[ -z "$note" ]] && note="$(head -1 "$out" 2>/dev/null)"
      [[ -z "$note" ]] && note="failed"
    fi

    note="$(display_scrub "$note")"

    if [[ "$code" == "0" ]]; then
      echo "  ${C_OK}✓${RESET} ${BOLD}${name}${RESET} ${C_DIM}— ${note}${RESET}"
      pull_ok=$((pull_ok + 1))
    else
      echo "  ${C_FAIL}✗${RESET} ${BOLD}${name}${RESET} ${C_DIM}— ${note}${RESET}"
      pull_failures+=("$name: $note")
      pull_fail=$((pull_fail + 1))
    fi
  done
  echo ""
fi

# ----------------------------------------------------------------------------
# Final report
# ----------------------------------------------------------------------------

total_conflicts=$(( ${#conflicts[@]} + ${#collisions[@]} ))
domain_url_count=$(( ${#declared_urls[@]} - ws_url_count ))

if [[ -f "$WS_DESCRIPTOR" ]]; then ws_present="present"; else ws_present="absent"; fi

echo "${BOLD}Summary${RESET}"
echo "  workspace:          $WORKSPACE"
echo "  lore-workspace.md:  $ws_present"
echo "  descriptors:        ${#descriptors[@]} lore-repo.md file(s)"
echo "  workspace-level:    $ws_url_count URL(s)"
echo "  domain-level:       $domain_url_count URL(s)"
echo "  phase 0:            $phase0_state"
if [[ ${#to_clone_url[@]} -gt 0 ]]; then
  echo "  cloned:             $clone_ok ok, $clone_fail failed"
fi
if [[ ${#top_level_repos[@]} -gt 0 ]]; then
  echo "  pulled:             $pull_ok ok, $pull_fail failed"
fi
if [[ $gitignore_added -gt 0 ]]; then
  echo "  gitignore:          +$gitignore_added entr(y/ies)"
fi
if [[ $total_conflicts -gt 0 ]]; then
  echo "  conflicts:          $total_conflicts (${#conflicts[@]} state, ${#collisions[@]} dir-collision)"
else
  echo "  conflicts:          0"
fi
echo ""

if [[ ${#descriptors[@]} -eq 0 && ${#top_level_repos[@]} -eq 0 && "$ws_present" == "absent" ]]; then
  echo "${C_WARN}No lore-workspace.md, no lore-repo.md files, and no git repos found in $WORKSPACE.${RESET}"
  echo "Are you running from the workspace root?"
  exit 0
fi

if [[ ${#conflicts[@]} -gt 0 ]]; then
  echo "${C_WARN}${BOLD}Conflicts (need manual resolution):${RESET}"
  for c in "${conflicts[@]}"; do
    echo "  ${C_WARN}!${RESET} $c"
  done
  echo ""
fi

if [[ ${#collisions[@]} -gt 0 ]]; then
  echo "${C_WARN}${BOLD}Target-dir collisions (multiple URLs map to the same dir):${RESET}"
  for c in "${collisions[@]}"; do
    echo "  ${C_WARN}!${RESET} $c"
  done
  echo ""
fi

if [[ ${#clone_failures[@]} -gt 0 ]]; then
  echo "${C_FAIL}${BOLD}Clone failures:${RESET}"
  for f in "${clone_failures[@]}"; do
    echo "  ${C_FAIL}*${RESET} $f"
  done
  echo ""
fi

if [[ ${#pull_failures[@]} -gt 0 ]]; then
  echo "${C_FAIL}${BOLD}Pull failures:${RESET}"
  for f in "${pull_failures[@]}"; do
    echo "  ${C_FAIL}*${RESET} $f"
  done
  echo ""
fi

# Undeclared-repo nudge. A top-level git repo that no descriptor declares is
# pulled by phase 4 but never *cloned* for anyone else — a teammate's fresh
# checkout of this workspace simply will not contain it. That is invisible from
# here, so name it. Informational only: it never affects the exit code, because
# an ad-hoc local repo in a workspace is a legitimate thing to have.
undeclared_dirs=()
for d in "$WORKSPACE"/*/; do
  d="${d%/}"
  [[ -L "$d" ]] && continue
  [[ -d "$d/.git" || -f "$d/.git" ]] || continue
  name="$(basename "$d")"
  is_declared=0
  for dir in "${present_dirs[@]:-}"; do
    [[ "$dir" == "$name" ]] && { is_declared=1; break; }
  done
  [[ $is_declared -eq 0 ]] && undeclared_dirs+=("$name")
done

if [[ ${#undeclared_dirs[@]} -gt 0 ]]; then
  echo "${BOLD}Undeclared top-level repos:${RESET} ${undeclared_dirs[*]}"
  echo "  Not in any lore-workspace.md or lore-repo.md \`repos:\` list, so a teammate's"
  echo "  workspace-pull will not clone them. Run workspace-init to declare them."
  echo ""
fi

total_problems=$(( clone_fail + pull_fail + total_conflicts ))
[[ $total_problems -gt 0 ]] && exit 1
exit 0
